generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MarketData {
  id        String   @id @default(cuid())
  symbol    String
  date      DateTime @db.Date
  close     Decimal  @db.Decimal(18, 6)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([symbol, date])
  @@index([date])
}

model MarketDataCoverage {
  id        String   @id @default(cuid())
  symbol    String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([symbol, startDate, endDate])
  @@index([symbol, startDate, endDate])
}

model SymbolInfo {
  symbol    String   @id
  name      String?
  currency  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}